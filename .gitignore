# Ignore large simulation output files
# Keep .m code files, ignore data and images

# ============ SIMULATION DATA (LARGE) ============
# MAT files (plist, sim data - can be many GB)
**/plist.mat
**/sim.mat
**/sim_params.mat
drivensinesims/**/*.mat

# Simulation folders themselves
drivensinesims/simulations/
**/sinusoidal_f*/

# ============ IMAGES ============
# Generated images from simulations (thousands per experiment)
**/images/
**/generated_images/
sinusoidal_*/0*.png
sinusoidal_*/*.png
PhononSims/**/*.png
strongimpulse*/*.png
**/plist_*.png
**/frame_*.png
**/kymograph_*.png

# Large video files
*.avi
*.mp4
*.mov

# ============ ANALYSIS OUTPUTS ============
# Analysis figures (can regenerate from data)
# Uncomment these if you want to exclude analysis too:
# drivensinesims/analysis/*.png
# drivensinesims/analysis/*.fig
# drivensinesims/analysis/*.mat

# ============ MATLAB TEMP FILES ============
*.asv
*.m~
*.autosave
*.mexa64
*.mexmaci64
*.mexw64

# ============ OS FILES ============
.DS_Store
Thumbs.db
desktop.ini
